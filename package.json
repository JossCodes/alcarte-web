{
  "name": "alcarte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "pnpm build && node scripts/check-pages-artifacts.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:start": "supabase start --exclude realtime,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop --project-id alcarte",
    "seed:demo-users": "node --env-file=.env.local scripts/seed-demo-users.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "supabase": "^3.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  }
}
